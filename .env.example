# Backend env. Copy to .env at the repo root (gitignored) and fill in values.
# Loaded by backend/src/config/env.js.

PORT=3001

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# World ID — developer.world.org
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=

# JWT — `openssl rand -hex 32` for a strong secret
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary — console.cloudinary.com → Dashboard / Settings → API Keys
# IMPORTANT: API_SECRET stays server-side only. Never bundle into the mobile app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# Optional: Cloudinary signs webhook payloads with this secret (Settings → Webhooks)
CLOUDINARY_WEBHOOK_SECRET=
