# Mobile env. Copy to mobile/.env (gitignored). Expo auto-loads vars
# prefixed with EXPO_PUBLIC_ and inlines them into the JS bundle.
# Use your Mac's LAN IP, not localhost — phones can't reach localhost.

EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Direct-to-Cloudinary uploads from the device. Cloud name and unsigned
# preset only. NEVER put the API secret here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
